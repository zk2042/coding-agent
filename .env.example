# SCNet Token Plan 配置
SCNET_BASE_URL=https://api.scnet.cn/api/llm/v1
SCNET_API_KEY=替换成你的TokenPlan专属APIKey
# 请填写 SCNet 控制台当前支持列表中的准确模型 ID
SCNET_MODEL=DeepSeek-V4.1-Flash-1017-Event

# Agent 参数
AGENT_MAX_STEPS=12
# 0 = 不限制任务总时长；单次模型请求与 Shell 命令仍各有独立超时
AGENT_TIMEOUT_SECONDS=0
# 单次模型请求时限。
MODEL_REQUEST_TIMEOUT_SECONDS=120
SHELL_TIMEOUT_SECONDS=60

# 目录与配置文件
WORKSPACE_DIR=./workspace
SKILLS_DIR=./skills
MCP_CONFIG=./configs/mcp.json

# 长期记忆：只保存跨任务稳定事实与偏好，不保存会话流水
MEMORY_ENABLED=true
MEMORY_FILE=./data/memory.json
